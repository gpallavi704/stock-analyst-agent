# Copy this file to .env and fill in your own key.
# Get a free key at https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Any model from https://console.groq.com/docs/models. The agent relies on tool
# calling, so the model must support it well. Verified working here:
#   qwen/qwen3.6-27b          (default -- grounded, and the most reliable tested)
#   openai/gpt-oss-120b       (equally reliable, heavier on the token budget)
#   llama-3.3-70b-versatile   (good, the heaviest on tokens)
# Avoid openai/gpt-oss-20b: it intermittently returns unparseable output.
# Avoid llama-3.1-8b-instant: it ignores the "no recommendations" instruction.
#
# Free-tier limits are PER MODEL, so switching models gives a fresh daily
# budget if you hit a 429 rate-limit error.
GROQ_MODEL=qwen/qwen3.6-27b

# Ticker used as the "just buy the index" baseline in benchmark comparisons.
BENCHMARK_TICKER=SPY

# Annual risk-free rate used for the Sharpe ratio, as a decimal.
RISK_FREE_RATE=0.045
