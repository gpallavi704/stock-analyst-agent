# Copy this file to .env and fill in your own key.
# Get a free key at https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Any model from https://console.groq.com/docs/models
# llama-3.3-70b-versatile is strongly recommended: the agent uses tool calling,
# and the smaller instant models are unreliable at choosing tools correctly.
GROQ_MODEL=llama-3.3-70b-versatile

# Ticker used as the "just buy the index" baseline in benchmark comparisons.
BENCHMARK_TICKER=SPY

# Annual risk-free rate used for the Sharpe ratio, as a decimal.
RISK_FREE_RATE=0.045
